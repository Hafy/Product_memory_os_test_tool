# ==========================================
# 1. Python 字节码与编译产物
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# 2. 虚拟环境 (Virtual Environments)
# ==========================================
venv/
env/
ENV/
.venv/
.env

# ==========================================
# 3. 打包与可执行文件 (PyInstaller 等)
# ==========================================
# 如果你使用 PyInstaller 打包，忽略生成的 exe 和打包目录
*.exe
*.spec
# 忽略打包生成的临时文件夹
build/
dist/
# 忽略打包时生成的 bat 脚本（临时 SOL 会话文件）
bat/

# ==========================================
# 4. 本地配置文件与敏感信息 (非常重要!)
# ==========================================
# 你的 servers.json 包含了服务器 IP、账号、密码，绝对不能传到 GitHub
servers.json
# SSH 密钥对，绝对不能传！
id_rsa
id_rsa.pub
*.pem
*.key

# ==========================================
# 5. 测试日志与运行结果 (非常重要!)
# ==========================================
# 你的代码中会生成大量测试日志（APPLog 和 logs）
APPLog/
logs/
# 如果临时生成的测试结果文件
*.log
*.xlsx
*.csv

# ==========================================
# 6. 远程与本地二进制、压缩包与资源
# ==========================================
# 如果你的目录下解压了各种测试工具，不要把庞大的二进制文件传上去
product_test_dir/
resources/
*.tar.gz
*.zip
# 但如果你一定要保留特定的资源(比如图标)，可以强制包含：
!tigo.ico

# ==========================================
# 7. 操作系统与 IDE 配置文件
# ==========================================
# Windows 系统文件
Thumbs.db
ehthumbs.db
Desktop.ini
# macOS 系统文件
.DS_Store
.AppleDouble
# VSCode / PyCharm 配置
.vscode/
.idea/
*.swp
*.swo